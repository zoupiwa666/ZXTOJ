{
  "name": "zxt-oj",
  "displayName": "ZXT OJ",
  "description": "提交代码到 ZXT OJ 并编辑题目",
  "version": "1.0.0",
  "publisher": "zxt",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:zxt-oj.login", "onCommand:zxt-oj.submit", "onCommand:zxt-oj.editProblem"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "zxt-oj.login", "title": "ZXT OJ: 登录（获取 OJCID）" },
      { "command": "zxt-oj.submit", "title": "ZXT OJ: 提交当前文件" },
      { "command": "zxt-oj.editProblem", "title": "ZXT OJ: 编辑题目" }
    ],
    "menus": {
      "editor/context": [
        { "command": "zxt-oj.submit", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "zxt-oj.login" },
        { "command": "zxt-oj.submit" },
        { "command": "zxt-oj.editProblem" }
      ]
    }
  },
  "scripts": { "vscode:prepublish": "node -e \"console.log('ok')\"" },
  "devDependencies": {}
}
